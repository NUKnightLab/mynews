# Local dev uses `supabase start` (a local Docker stack), not a hosted
# project - see README.md "Local development". These values are the
# well-known local-stack defaults `supabase start` prints; they're the
# same on every machine, not secrets, safe to commit here as-is.
# Copy this file to .env.local (which IS git-ignored) and you're done -
# no Supabase account needed for local dev.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - server-only, bypasses Row Level Security.
# Used for privileged actions like issuing invites.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Shared secret for the feed-polling cron endpoint (see vercel.json and
# src/app/api/cron/poll-feeds/route.ts). Any value works for local dev -
# generate a real one with `openssl rand -hex 32` for production, set in
# Vercel's env vars too (Vercel Cron sends it as `Authorization: Bearer
# $CRON_SECRET` automatically).
CRON_SECRET=local-dev-only

# Optional: how long to keep ingested items before the cron job prunes
# them (defaults to 180 if unset).
# PRUNE_ITEMS_AFTER_DAYS=180
