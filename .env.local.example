# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - server-only, bypasses Row Level Security.
# Used for privileged actions like issuing invites. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the feed-polling cron endpoint (see vercel.json and
# src/app/api/cron/poll-feeds/route.ts). Generate with:
#   openssl rand -hex 32
# In production, set this in Vercel's env vars too - Vercel Cron sends it
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Optional: how long to keep ingested items before the cron job prunes
# them (defaults to 180 if unset).
# PRUNE_ITEMS_AFTER_DAYS=180
